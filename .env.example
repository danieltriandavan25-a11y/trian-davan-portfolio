# EmailJS configuration for the Contact section.
# Copy this file to .env and fill in the real values from your EmailJS
# dashboard (https://dashboard.emailjs.com/). Never commit the real .env file.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
